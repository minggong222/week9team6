#ifndef SHADER_CONSTANTS_INCLUDED
#define SHADER_CONSTANTS_INCLUDED

// Mathematical constants used by shaders.
#define PI_PRECISE (3.14159265358979323846f)
#define TWO_PI_PRECISE (2.0f * PI_PRECISE)
#define GOLDEN_ANGLE (2.39996322972865332f)
#define SQRT_HALF (0.70710678118654752440f)

// Absolute tolerances for shader calculations.
#define EPSILON_1E_4 (1.e-4f)
#define EPSILON_1E_6 (1.e-6f)
#define EPSILON_1E_8 (1.e-8f)
#define EPSILON_1E_12 (1.e-12f)

#endif // SHADER_CONSTANTS_INCLUDED
